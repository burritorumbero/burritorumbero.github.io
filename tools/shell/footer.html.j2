  <footer class="site-footer">
    <p>© 2026 Burrito Rumbero</p>
  </footer>

  <!-- ============ MASCOT ============ -->
  {# mascot_src lets a story or comic bring its own mascot; everything else
     gets the site default. The router watches this img across SPA
     navigations and swaps it when a page declares a different one. #}
  <div class="mascot" id="mascot">
    <img src="{{ mascot_src | default(root ~ 'assets/mascot.webp') }}" alt="">
  </div>

  <script src="{{ root }}js/script.js"></script>
  <script src="{{ root }}js/router.js"></script>
