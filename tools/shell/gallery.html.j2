{% extends "base.html.j2" %}

{% block head_extra %}
  <link rel="stylesheet" href="{{ root }}stories/css/story.css">
{%- if cover.preload %}

  {# The cover is this page's hook. This preload mirrors the first <source>
     below exactly — same format, same srcset — or the browser fetches twice. #}
  <link
    rel="preload"
    as="image"
    type="{{ cover.preload.mime }}"
    imagesrcset="{{ cover.preload.srcset }}"
    imagesizes="{{ cover.sizes }}"
    fetchpriority="high">
{%- endif %}
{% endblock %}

{% block content %}
    <article class="story">
      <p class="story-back"><a href="../index.html">← All comics</a></p>

      <div class="story-cover">
        {%- if cover.img %}
        <picture>
          {%- for source in cover.sources %}
          <source
            type="{{ source.mime }}"
            srcset="{{ source.srcset }}"
            sizes="{{ cover.sizes }}">
          {%- endfor %}
          <img
            src="{{ cover.img.src }}"
            srcset="{{ cover.img.srcset }}"
            sizes="{{ cover.sizes }}"
            width="1600" height="900"
            alt="{{ comic.title }} cover art"
            fetchpriority="high"
            decoding="async">
        </picture>
        {%- endif %}
      </div>

      <h2 class="story-title">{{ comic.title }}</h2>

      {%- if comic.genres %}
      <ul class="story-genres">
        {%- for genre in comic.genres %}
        <li>{{ genre }}</li>
        {%- endfor %}
      </ul>
      {%- endif %}

      <p class="story-details">
        <span>Release:</span> <b>{{ comic.release }}</b>
        <span>Status:</span> <b>{{ comic.status }}</b>
        <span>Pages:</span> <b>{{ pages | length }}</b>
      </p>

      {%- if pages %}
      <div class="story-actions">
        <a class="story-btn" href="read/index.html">Start Comic</a>
        <a class="story-btn story-btn--last" href="browse/index.html">Browse Comic</a>
      </div>
      {%- endif %}

      <section class="story-about">
        <h3>About</h3>
        <p class="story-synopsis">{{ comic.synopsis }}</p>
        <button class="story-toggle story-toggle--synopsis" type="button"
                aria-expanded="false" hidden>Show more ⬇️</button>
      </section>
    </article>
{% endblock %}

{% block scripts %}
  <script src="{{ root }}stories/js/story.js"></script>
{% endblock %}
