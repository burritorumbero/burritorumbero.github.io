{% extends "base.html.j2" %}

{% block head_extra %}
  <link rel="stylesheet" href="{{ root }}stories/css/story.css">
{% endblock %}

{% block content %}
    <article class="story">
      <p class="story-back"><a href="../../index.html">← {{ story.title }}</a></p>

      <h2 class="story-title">{{ chapter.title }}</h2>
      <p class="story-details">
        <span>Uploaded:</span>
        <b><time datetime="{{ chapter.iso }}">{{ chapter.human }}</time></b>
      </p>

      <div class="chapter-body">
        {%- for paragraph in chapter.paragraphs %}
        <p>{{ paragraph }}</p>
        {%- endfor %}
      </div>

      <nav class="chapter-nav">
        {%- if prev %}
        <a href="../{{ prev.id }}/index.html">← {{ prev.title }}</a>
        {%- else %}
        <span></span>
        {%- endif %}
        {%- if next %}
        <a href="../{{ next.id }}/index.html">{{ next.title }} →</a>
        {%- else %}
        <span></span>
        {%- endif %}
      </nav>
    </article>
{% endblock %}

{% block scripts %}
  <script src="{{ root }}stories/js/story.js"></script>
{% endblock %}
